{
  "name": "kvnsys",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "check:structure": "depcruise src --config .dependency-cruiser.cjs",
    "build": "pnpm --filter @kvnsys/postgres generate && pnpm check:structure && pnpm -r build",
    "test": "pnpm -r test",
    "db:deploy": "pnpm --filter @kvnsys/postgres migrate:deploy",
    "seed": "pnpm --filter @kvnsys/server seed",
    "start:server": "pnpm --filter @kvnsys/server start",
    "start:app": "pnpm --filter @kvnsys/client-app start",
    "package": "pnpm build && node scripts/package.mjs",
    "install:here": "node scripts/install-here.mjs",
    "fetch:installer-parts": "node scripts/fetch-installer-parts.mjs"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "dependency-cruiser": "18.6.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "postject": "1.0.0-alpha.6",
    "typescript": "5.9.3"
  }
}
