# Copy this to .env (which is never committed) and fill it in.

# The port KVNsys Server listens on. Registers connect to it on the shop's network.
KVNSYS_PORT=9000

# The database this server owns.
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/kvnsys

# Read only by `pnpm seed`. The password is needed the first time only, to create the
# first administrator (at least 8 characters).
KVNSYS_ADMIN_PASSWORD=
KVNSYS_LOCATION_CODE=HQ
KVNSYS_LOCATION_NAME=Head Office

# Optional. A PostgreSQL server where the database tests may create, and then drop, their
# own throwaway databases. They never touch an existing database. Without it, those tests
# show as skipped.
KVNSYS_TEST_POSTGRES_URL=postgresql://postgres:CHANGE_ME@localhost:5432/postgres
