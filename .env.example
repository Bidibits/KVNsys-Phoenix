# Copy to .env (never committed) and fill in.

# The database this server owns.
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/phoenix_dev

# Signs session cookies. Any long random string; changing it signs everyone out.
PHOENIX_SESSION_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING

PORT=3000

# Only read by `pnpm seed`, the first time it runs.
PHOENIX_ADMIN_PASSWORD=
PHOENIX_LOCATION_CODE=HQ
PHOENIX_LOCATION_NAME=Head Office

# Integration tests run only when this is set, and refuse any database
# whose name does not end in _test, because they wipe it.
PHOENIX_TEST_DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/phoenix_test
