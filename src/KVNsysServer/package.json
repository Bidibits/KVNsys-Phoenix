{
  "name": "@kvnsys/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "source": "./index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./control": {
      "source": "./control/index.ts",
      "types": "./dist/control/index.d.ts",
      "default": "./dist/control/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "seed": "node --env-file-if-exists=../../.env dist/setup/seed-command.js",
    "start": "node --env-file-if-exists=../../.env dist/start.js"
  },
  "dependencies": {
    "@kvnsys/core": "workspace:*",
    "@kvnsys/postgres": "workspace:*",
    "@kvnsys/wire": "workspace:*",
    "@nestjs/common": "12.1.3",
    "@nestjs/core": "12.1.3",
    "@nestjs/platform-express": "12.1.3",
    "@peculiar/x509": "2.2.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "24.19.2"
  }
}
