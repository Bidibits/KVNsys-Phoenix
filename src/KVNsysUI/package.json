{
  "name": "@kvnsys/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "source": "./index.ts",
      "types": "./index.ts",
      "default": "./index.ts"
    },
    "./styles.css": "./styles.css",
    "./components/*": {
      "source": "./components/*.tsx",
      "types": "./components/*.tsx",
      "default": "./components/*.tsx"
    },
    "./lib/*": {
      "source": "./lib/*.ts",
      "types": "./lib/*.ts",
      "default": "./lib/*.ts"
    },
    "./hooks/*": {
      "source": "./hooks/*.ts",
      "types": "./hooks/*.ts",
      "default": "./hooks/*.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@kvnsys/core": "workspace:*",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0"
  }
}
